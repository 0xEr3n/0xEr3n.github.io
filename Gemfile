source "https://rubygems.org"
# GitHub Pages gem — pinned to current version (Bundler picks ancient ones otherwise)
gem "github-pages", "~> 232", group: :jekyll_plugins
# Windows needs an explicit timezone database
gem "tzinfo-data", platforms: [:mingw, :mswin, :x64_mingw, :jruby]
# Windows-only file watcher (Jekyll needs this for --livereload)
# Ruby 3.x no longer ships webrick
gem "webrick", "~> 1.8"